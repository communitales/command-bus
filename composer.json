{
    "name": "communitales/command-bus",
    "description": "Communitales Command Bus Component",
    "keywords": [
        "command-bus",
        "php"
    ],
    "type": "library",
    "homepage": "https://www.communitales.com",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "communitales/log": "^4.0",
        "communitales/status-bus": "^3.0",
        "symfony/config": "^7.4|^8.1",
        "symfony/dependency-injection": "^7.4|^8.1",
        "symfony/http-kernel": "^7.4|^8.1",
        "symfony/service-contracts": "^3.7"
    },
    "require-dev": {
        "doctrine/orm": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6"
    },
    "conflict": {
        "doctrine/orm": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "Communitales\\Component\\CommandBus\\": "src/CommandBus"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Communitales\\Test\\Unit\\Component\\CommandBus\\": "tests/Unit"
        }
    },
    "scripts": {
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "codecheck": [
            "@rector",
            "@php-cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
